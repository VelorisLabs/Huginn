# ============================================================
# 生产环境配置示例
# 复制此文件为 .env 并修改对应的值
# ============================================================

# ---------- 安全配置（必须修改！） ----------
# JWT 签名密钥，至少 32 个字符的随机字符串
SECRET_KEY=your-super-secret-key-min-32-characters-long

# 调试模式（生产环境必须设为 False）
DEBUG=False

# ---------- 数据库配置 ----------
DATABASE_URL=sqlite+aiosqlite:///./paper_analysis.db

# ---------- Redis 配置（Celery 任务队列） ----------
REDIS_URL=redis://localhost:6379/0

# ---------- LLM API 配置 ----------
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=180.0

# ---------- 文件上传配置 ----------
# 最大上传大小（字节），默认 100MB
# MAX_UPLOAD_SIZE=104857600

# ---------- CORS 配置 ----------
# JSON 数组格式，列出允许的前端域名
BACKEND_CORS_ORIGINS=["https://your-domain.com"]

# ---------- 服务器配置 ----------
HOST=0.0.0.0
PORT=8000

# ---------- 域名配置（用于 Nginx 等） ----------
DOMAIN=papers.velorislab.com
